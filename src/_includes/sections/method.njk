{%- from "macros.njk" import head, bg -%}
<section {{ bg(s, "grain") }}><div class="wrap">
{{ head(s) }}
<div class="method-steps">
{%- for st in s.steps -%}
<div class="method-step reveal"><div class="stage">{% if loop.index < 10 %}0{% endif %}{{ loop.index }}</div><div><div class="q">{{ st.question | mdi | safe }}</div><h3>{{ st.title | mdi | safe }}</h3><p>{{ st.text | mdi | safe }}</p></div></div>
{%- endfor -%}
</div>
{%- if s.closing_line %}
<div class="method-close reveal"><p class="say">{{ s.closing_line | mdi | safe }}</p>
{%- if s.closing_button and s.closing_button.link %}<div class="btn-row center"><a class="btn btn-gold" href="{{ s.closing_button.link }}">{{ s.closing_button.label | mdi | safe }}</a></div>{% endif -%}
</div>
{%- endif %}
</div></section>
