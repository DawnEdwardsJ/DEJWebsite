{%- from "macros.njk" import head -%}
<section class="sec ivory" id="enquire"><div class="wrap">
{{ head(s) }}
<form class="nd-form" id="enquiry" action="/api/enquiry" method="post"
  data-success="{{ s.success_message }}" data-error="{{ s.error_message }}">
<div class="row-2">
<div><label for="f-name">First name</label><input id="f-name" name="first_name" type="text" autocomplete="given-name" required maxlength="80"></div>
<div><label for="f-last">Last name</label><input id="f-last" name="last_name" type="text" autocomplete="family-name" maxlength="80"></div>
</div>
<div class="row-2">
<div><label for="f-email">Email</label><input id="f-email" name="email" type="email" autocomplete="email" required maxlength="160"></div>
<div><label for="f-phone">Phone (optional)</label><input id="f-phone" name="phone" type="tel" autocomplete="tel" maxlength="40"></div>
</div>
<div><label for="f-about">What is this about?</label>
<select id="f-about" name="enquiry_type">
{%- for t in enquiry.types %}<option value="{{ t.value }}">{{ t.label }}</option>{% endfor -%}
</select></div>
<div><label for="f-msg">Your message</label><textarea id="f-msg" name="message" maxlength="5000" placeholder="{{ s.message_placeholder }}"></textarea></div>
<div class="hp" aria-hidden="true"><label for="f-website">Leave this empty</label><input id="f-website" name="company_website" type="text" tabindex="-1" autocomplete="off"></div>
<input type="hidden" name="page" value="{{ page.url }}">
<div class="btn-row"><button class="btn btn-gold" type="submit">{{ s.button_label }}</button></div>
<p class="fine">{{ s.fine_print | mdi | safe }}</p>
<p class="fine form-status" id="f-status" role="status" aria-live="polite"></p>
</form>
</div></section>
