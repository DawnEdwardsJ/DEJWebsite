{%- from "macros.njk" import head, bg -%}
<section {{ bg(s) }}><div class="wrap">
{{ head(s) }}
<div class="doorways">
{%- for d in s.doors | liveLinks -%}
<a class="door reveal" data-delay="{{ (loop.index0 % 2) * 70 }}" href="{{ d.link }}"><div class="intent">{{ d.intent | mdi | safe }}</div><h3>{{ d.title | mdi | safe }}</h3><p>{{ d.text | mdi | safe }}</p><span class="go">{{ d.link_label | mdi | safe }} &rarr;</span></a>
{%- endfor -%}
</div>
</div></section>
